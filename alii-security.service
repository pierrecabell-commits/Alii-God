[Unit]
Description=Alii Security Agent - Continuous Monitor
After=network.target

[Service]
Type=simple
User=avalii
WorkingDirectory=/home/avalii/moltbot
ExecStart=/usr/bin/python3 /home/avalii/moltbot/security_agent.py --mode access
Restart=always
RestartSec=3600
StandardOutput=append:/home/avalii/moltbot/logs/security_agent.log
StandardError=append:/home/avalii/moltbot/logs/security_agent.log

[Install]
WantedBy=multi-user.target
