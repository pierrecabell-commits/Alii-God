[Unit]
Description=Alii Money Agent — Revenue tracking and financial reports
After=network.target alii-vault.service

[Service]
Type=simple
User=avalii
WorkingDirectory=/home/avalii/moltbot
EnvironmentFile=/home/avalii/moltbot/.env
ExecStart=/home/avalii/moltbot/venv/bin/python3 /home/avalii/moltbot/run_money_agent.py
Restart=on-failure
RestartSec=60
StandardOutput=append:/home/avalii/moltbot/logs/money_agent.log
StandardError=append:/home/avalii/moltbot/logs/money_agent.log

[Install]
WantedBy=default.target
